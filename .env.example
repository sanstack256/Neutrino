# Neutrino Environment Configuration
# Copy this file to .env for local development

# Runtime Environment
NODE_ENV=development
LOG_LEVEL=info

# API Service
PORT=4000
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# FalkorDB Graph Database Configuration
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=neutrino_graph
FALKORDB_TEST_GRAPH_NAME=neutrino_test_graph

# Timeouts & Limits
QUERY_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=10000
MAX_GRAPH_TRAVERSAL_DEPTH=5
MAX_GRAPH_RESULTS_BOUND=100

# Optional LLM Integration (Stage 1 runs deterministically by default without keys)
# Set to 'none' for Deterministic Foundation Mode, or configure provider if available
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
